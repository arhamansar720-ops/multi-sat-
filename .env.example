# ---------------------------------------------------------------------------
# StudyDuel environment variables
# Copy to .env.local for local development. Never commit real values.
# Leave DATABASE_URL empty to run in demo mode (browser-only storage).
# ---------------------------------------------------------------------------

# Server-only. Postgres connection string. On Render: your database's
# "External Database URL" (or the "Internal Database URL" if the app also runs
# on Render). Tables are created automatically on first use.
DATABASE_URL=

# Optional: TLS for the database. Defaults to on (unverified) for remote hosts
# and off for localhost/internal hosts. One of: disable, require, verify.
DATABASE_SSL=

# Optional: password reset emails via Resend (https://resend.com).
# EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=StudyDuel <noreply@example.com>
# Optional: base URL for links in emails (defaults to the request's origin).
APP_URL=

# Optional: protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Optional: force demo mode even when DATABASE_URL is present.
NEXT_PUBLIC_FORCE_DEMO_MODE=false
