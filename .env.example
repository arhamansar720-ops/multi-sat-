# ---------------------------------------------------------------------------
# StudyDuel environment variables
# Copy to .env.local for local development. Never commit real values.
# Leave the Supabase values empty to run in demo mode (browser-only storage).
# ---------------------------------------------------------------------------

# Public (sent to the browser). From Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# Either the legacy "anon" key or the newer publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by API routes for trusted writes (grading, XP, rooms).
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Optional: force demo mode even when Supabase variables are present.
NEXT_PUBLIC_FORCE_DEMO_MODE=false
